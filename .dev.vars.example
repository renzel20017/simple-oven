# Copy to .dev.vars for local testing (`npm run dev`).
# For the live site, add the same names in Cloudflare → your Pages project → Settings → Variables and Secrets.
# NEVER commit real values.

RESEND_API_KEY=re_your_key_here
ORDER_TO_EMAIL=your-orders-inbox@example.com

# Password for the owner page (/#/admin)
ADMIN_PASSWORD=choose-a-long-password

# Optional (need a domain verified in Resend):
# ORDER_FROM_EMAIL=Simple Oven <orders@yourdomain.com>
# SEND_CUSTOMER_CONFIRMATION=true
# ALLOWED_ORIGIN=https://simple-oven.pages.dev

# Optional: Google Sheets order log (see README)
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# SHEETS_SECRET=same-secret-as-in-apps-script
